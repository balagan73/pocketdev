#!/bin/bash
# Trigger APK build and Telegram delivery after merging into master.

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

if [[ "$BRANCH" == "master" || "$BRANCH" == "main" ]]; then
  echo "[CI] Merge into $BRANCH detected — starting build..."
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  bash "$REPO_ROOT/scripts/build-and-send.sh" &
  echo "[CI] Build started in background (PID $!)"
fi
