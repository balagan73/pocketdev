# OpenClaw persistent runtime data (config, Telegram pairing, gateway token, Claude CLI cache)
/.openclaw/data/*
!/.openclaw/data/.gitkeep

# Generated by rebuild.sh from the selected stacks' env.sh files
/.openclaw/pocketdev-stacks.env

# Generated by rebuild.sh when the usage-metrics extension is selected
# (sets COMPOSE_FILE so the metrics overlay is picked up automatically)
/.env

# Git worktree checkouts
/.worktrees/

# Ad-hoc task backlog for AI agents (MVP, not yet tracked via GitHub issues)
/tasks/

# OpenClaw workspace scaffold (auto-generated persona/memory files, created
# on first run because OPENCLAW_WORKSPACE_DIR points at the project root)
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
/openclaw-workspace-state.json

# Planning/process docs (specs, plans) — scratch, not committed
/docs/superpowers/specs/
/docs/superpowers/plans/

# Subagent-driven-development workspaces (ledgers, briefs, reports, backups) — scratch
/.superpowers/
